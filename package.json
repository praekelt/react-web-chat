{
    "name": "@prk/react-web-chat",
    "version": "2.0.0",
    "description": "react-web-chat React component",
    "type": "module",
    "main": "lib/index.js",
    "module": "es/index.js",
    "exports": {
        ".": {
            "import": "./es/index.js",
            "require": "./lib/index.js"
        },
        "./umd/main.css": "./umd/main.css"
    },
    "files": [
        "es",
        "lib",
        "umd"
    ],
    "scripts": {
        "clean": "rm -rf dist es lib umd src/themes/default/styles.css",
        "build:css": "mkdir -p umd && sass --style=compressed --no-source-map src/themes/default/styles.scss umd/main.css && cp umd/main.css src/themes/default/styles.css",
        "build": "yarn build:css && NODE_ENV=production rollup -c",
        "build:dev": "yarn build:css && NODE_ENV=development rollup -c",
        "build:staging": "yarn build:css && NODE_ENV=staging rollup -c",
        "test-umd": "node serve.js",
        "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "dependencies": {
        "lodash": "^4.17.21",
        "react-linkify": "^1.0.0-alpha",
        "react-markdown": "^8.0.7",
        "react-redux": "^8.1.3",
        "react-slick": "^0.29.0",
        "react-transition-group": "^4.4.5",
        "redux": "^4.2.1",
        "redux-thunk": "^2.4.2",
        "rwc-feersum-client": "^1.4.0",
        "slick-carousel": "^1.8.1",
        "smooth-scroll-to-js": "^0.0.2"
    },
    "devDependencies": {
        "@babel/core": "^7.23.5",
        "@babel/preset-env": "^7.23.5",
        "@babel/preset-react": "^7.23.3",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@testing-library/react": "^14.0.0",
        "dotenv": "^16.5.0",
        "eslint": "^8.53.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.4",
        "prop-types": "^15.8.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rollup": "^4.6.1",
        "rollup-plugin-scss": "^4.0.0",
        "sass": "^1.69.5"
    },
    "license": "MIT",
    "repository": "git@github.com:praekelt/react-web-chat.git",
    "keywords": [
        "react-component"
    ]
}
