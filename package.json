{
    "name": "@prk/react-web-chat",
    "version": "1.6.13",
    "description": "react-web-chat React component",
    "type": "module",
    "main": "dist/react-web-chat.js",
    "module": "dist/react-web-chat.mjs",
    "unpkg": "dist/react-web-chat.min.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "css"
    ],
    "scripts": {
        "dev": "rollup -c -w",
        "build": "rollup -c --bundleConfigAsCjs && npm run build:css && npm run build:types",
        "build:css": "sass src/themes/default/styles.scss:umd/main.css --style=compressed",
        "build:types": "cp src/index.d.ts dist/index.d.ts",
        "lint": "eslint src --ext ts,tsx",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "type-check": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "dependencies": {
        "lodash": "^4.17.21",
        "react-linkify": "^1.0.0-alpha",
        "react-markdown": "^9.0.1",
        "react-redux": "^8.1.3",
        "react-slick": "^0.30.2",
        "react-transition-group": "^4.4.5",
        "redux": "^4.2.1",
        "redux-thunk": "^2.4.2",
        "rwc-feersum-client": "^1.4.0",
        "slick-carousel": "^1.8.1",
        "smooth-scroll-into-view-if-needed": "^2.0.2"
    },
    "devDependencies": {
        "@babel/core": "^7.26.9",
        "@babel/plugin-proposal-decorators": "^7.25.9",
        "@babel/preset-react": "^7.23.3",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.5",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/jest": "^29.5.12",
        "@types/lodash": "^4.17.16",
        "@types/react": "^18.2.64",
        "@types/react-dom": "^18.2.21",
        "@types/react-slick": "^0.23.13",
        "@types/react-transition-group": "^4.4.12",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "rollup": "^4.9.6",
        "rollup-plugin-dts": "^6.1.0",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "sass": "^1.71.1",
        "tslib": "^2.6.2",
        "typescript": "^5.4.2"
    },
    "engines": {
        "node": ">=18.18.0"
    },
    "license": "MIT",
    "repository": "git@github.com:praekelt/react-web-chat.git",
    "keywords": [
        "react-component"
    ]
}
